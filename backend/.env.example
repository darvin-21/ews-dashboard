# Optional. If unset, FRED indicators will gracefully be marked "Data unavailable".
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Refresh cadence (minutes). World Bank/IMF are annual, so a few hours is enough.
REFRESH_INTERVAL_MIN=180

# News refresh cadence (minutes). RSS feeds update intraday.
NEWS_REFRESH_INTERVAL_MIN=30

# CORS — Vite dev server. Add tunnel hosts if needed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite path. Override to point elsewhere.
DATABASE_URL=sqlite:///./ews_cache.db
